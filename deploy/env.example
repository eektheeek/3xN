# Copy to deploy/env and fill in (deploy/env is gitignored).
DEPLOY_HOST=192.144.58.51
DEPLOY_USER=root
DEPLOY_DOMAIN=my3xn.duckdns.org

# Required on first API boot after auth migration (legacy owner email is fixed in code).
DIARY_BOOTSTRAP_PASSWORD=

# Remote paths (match systemd + Caddyfile)
REMOTE_API_DIR=/opt/3xn/api
REMOTE_WEB_DIR=/opt/3xn/web

# Linux target for cross-compile from macOS
GOOS=linux
GOARCH=amd64
